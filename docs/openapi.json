{
  "info": {
    "title": "BrightPath API",
    "description": "Backend API for BrightPath. This spec is the contract for the frontend: every route documents its summary, request body and responses. Exported to docs/openapi.json via `bun run openapi:export`.",
    "version": "0.1.0"
  },
  "tags": [
    {
      "name": "Health",
      "description": "Service and dependency health"
    },
    {
      "name": "Jobs",
      "description": "Background job enqueueing (BullMQ)"
    }
  ],
  "openapi": "3.1.2",
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Probes Postgres and Redis. Returns 200 when both are reachable, 503 when any dependency is down. Use this for container/orchestrator health checks and for the frontend to detect an unavailable backend.",
        "responses": {
          "200": {
            "description": "All dependencies are healthy",
            "content": {
              "application/json": {
                "schema": {
                  "description": "All dependencies are healthy",
                  "type": "object",
                  "required": [
                    "status",
                    "uptimeSeconds",
                    "services"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok",
                      "type": "string"
                    },
                    "uptimeSeconds": {
                      "description": "Seconds since the API process started",
                      "type": "number"
                    },
                    "services": {
                      "type": "object",
                      "required": [
                        "database",
                        "redis"
                      ],
                      "properties": {
                        "database": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        },
                        "redis": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "At least one dependency is down",
            "content": {
              "application/json": {
                "schema": {
                  "description": "At least one dependency is down",
                  "type": "object",
                  "required": [
                    "status",
                    "uptimeSeconds",
                    "services"
                  ],
                  "properties": {
                    "status": {
                      "const": "degraded",
                      "type": "string"
                    },
                    "uptimeSeconds": {
                      "type": "number"
                    },
                    "services": {
                      "type": "object",
                      "required": [
                        "database",
                        "redis"
                      ],
                      "properties": {
                        "database": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        },
                        "redis": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "getHealth"
      }
    },
    "/jobs/example": {
      "post": {
        "tags": [
          "Jobs"
        ],
        "summary": "Enqueue an example background job",
        "description": "Adds a job to the `example` BullMQ queue and returns immediately with 202 Accepted. The worker process (`bun run worker`) picks it up asynchronously.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "minLength": 1,
                    "maxLength": 500,
                    "description": "Free-text payload handed to the worker",
                    "type": "string"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "minLength": 1,
                    "maxLength": 500,
                    "description": "Free-text payload handed to the worker",
                    "type": "string"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "minLength": 1,
                    "maxLength": 500,
                    "description": "Free-text payload handed to the worker",
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted for processing",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Job accepted for processing",
                  "type": "object",
                  "required": [
                    "jobId",
                    "queue"
                  ],
                  "properties": {
                    "jobId": {
                      "description": "BullMQ job id",
                      "type": "string"
                    },
                    "queue": {
                      "description": "Queue the job was added to",
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "postJobsExample"
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
