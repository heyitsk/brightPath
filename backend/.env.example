# Copy to .env and fill in.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://brightpath:change-me@localhost:5434/brightpath?schema=public
REDIS_URL=redis://:change-me@localhost:6381
# Only true behind a reverse proxy you control (trusts X-Forwarded-For for client IPs)
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MIN=300
MAX_BODY_BYTES=1048576
SESSION_TTL_DAYS=7
# Long random string (e.g. `openssl rand -hex 32`). Required in production.
IP_HASH_SALT=change-me
# One-time: used by `bun run admin:bootstrap` to create the first ADMIN. Remove afterwards.
# ADMIN_BOOTSTRAP_EMAIL=you@example.com
# ADMIN_BOOTSTRAP_PASSWORD=at-least-12-characters
