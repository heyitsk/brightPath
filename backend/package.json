{
  "name": "brightpath-backend",
  "version": "1.0.50",
  "dependencies": {
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/openapi": "^1.4.17",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@sinclair/typebox": "0.34.52",
    "bullmq": "^6.7.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "elysia": "1.4.30",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "worker": "bun run src/worker.ts",
    "worker:dev": "bun run --watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "openapi:export": "bun run scripts/export-openapi.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "NODE_ENV=test bun run scripts/prepare-test-db.ts && NODE_ENV=test bun test",
    "test:watch": "NODE_ENV=test bun test --watch",
    "db:reset": "prisma migrate reset",
    "db:seed": "bun run prisma/seed.ts",
    "admin:bootstrap": "bun run scripts/bootstrap-admin.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module"
}
