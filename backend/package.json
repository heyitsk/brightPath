{
  "name": "brightpath-backend",
  "version": "1.0.50",
  "dependencies": {
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/openapi": "^1.4.17",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.7.0",
    "dotenv": "^18.0.9",
    "elysia": "^1.4.31",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "worker": "bun run src/worker.ts",
    "worker:dev": "bun run --watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "openapi:export": "bun run scripts/export-openapi.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module"
}
